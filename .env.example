# Copy this file to .env next to app.py, enter your key, then restart Streamlit.
# API key is used only on the Python server. Never paste it in chat or commit it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
ENABLE_EMBEDDINGS=0
# Optional: Media Cloud v4 search enrichment; leave blank to disable.
MEDIACLOUD_API_KEY=
PULSE_DB=data/pulse.sqlite3
PULSE_TIMEOUT=20
